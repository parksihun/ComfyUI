# Only our own work is tracked. Everything ComfyUI-Easy-Install ships (python_embeded, ComfyUI core,
# models, other custom nodes, outputs) stays untracked so this repo can live inside any
# ComfyUI-Easy-Install folder.
*
!.gitignore
!README.md
!Setup_Folders.bat
!Start ComfyUI CPU.bat
!Start_ComfyUI_L40S.bat
!extra_model_paths.yaml

!workflow/
!workflow/**

!custom_nodes/
!custom_nodes/ComfyUI-ShortsRemake/
!custom_nodes/ComfyUI-ShortsRemake/**
!custom_nodes/ComfyUI-WanChain/
!custom_nodes/ComfyUI-WanChain/**
# third-party nodes vendored for the Wan 2.2 SVI workflow (git metadata stripped)
!custom_nodes/ComfyUI-Wan22FMLF/
!custom_nodes/ComfyUI-Wan22FMLF/**
!custom_nodes/ComfyUI-Frame-Interpolation/
!custom_nodes/ComfyUI-Frame-Interpolation/**
custom_nodes/ComfyUI-Frame-Interpolation/demo_frames/
custom_nodes/ComfyUI-Frame-Interpolation/*.gif
!custom_nodes/ComfyUI-Custom-Scripts/
!custom_nodes/ComfyUI-Custom-Scripts/**

!tools/
!tools/**

__pycache__/
*.pyc
